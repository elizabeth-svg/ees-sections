{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ees/article-rows",
	"title": "EES Article Rows",
	"category": "design",
	"icon": "list-view",
	"description": "Eyebrow, headline, and a list of article links (category, title, standfirst, link). Add, edit or remove rows.",
	"keywords": [ "ees", "articles", "thoughts", "list" ],
	"textdomain": "ees-sections",
	"attributes": {
		"eyebrow":  { "type": "string", "default": "" },
		"headline": { "type": "string", "default": "" },
		"rows":     { "type": "array", "default": [] }
	},
	"supports": { "html": false, "anchor": true },
	"editorScript": "ees-article-rows-editor",
	"style": "ees-sections-style",
	"render": "file:./render.php"
}
