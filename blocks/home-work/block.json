{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ees/home-work",
  "title": "Home \u00b7 Work",
  "category": "design",
  "icon": "cover-image",
  "description": "eaglesimbeye.com Home \u2014 work section (verbatim design markup + motion hooks).",
  "supports": {
    "html": false,
    "reusable": false,
    "multiple": false,
    "inserter": true,
    "lock": false
