{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ees/numbered-rows",
	"title": "EES Numbered Rows",
	"category": "design",
	"icon": "editor-ol",
	"description": "Eyebrow, headline, and a list of auto-numbered rows (title + description). Add, edit or remove rows.",
	"keywords": [ "ees", "rows", "focus", "list" ],
	"textdomain": "ees-sections",
	"attributes": {
		"eyebrow":  { "type": "string", "default": "" },
		"headline": { "type": "string", "default": "" },
		"rows":     { "type": "array", "default": [] }
	},
	"supports": { "html": false, "anchor": true },
	"editorScript": "ees-numbered-rows-editor",
	"style": "ees-sections-style",
	"render": "file:./render.php"
}
